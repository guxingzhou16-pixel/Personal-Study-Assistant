{
  "name": "personal-study-assistant",
  "version": "0.1.1",
  "description": "拾知：本地模型优先的学习助手，支持资料阅读、可追溯问答与学习计划。",
  "author": {
    "name": "guxingzhou16-pixel"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "eval:retrieval": "node scripts/eval-retrieval.mjs",
    "model:download": "node scripts/download-embedding.mjs",
    "eval:hybrid": "node scripts/eval-retrieval.mjs --hybrid",
    "test:embedding": "playwright test --config playwright.embedding.config.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "desktop:dev": "npm run build:electron && node scripts/dev.mjs",
    "desktop:build": "npm run build && npm run build:electron",
    "desktop:pack": "npm run desktop:build && node scripts/package-desktop.mjs dir",
    "desktop:dist": "npm run desktop:build && node scripts/package-desktop.mjs nsis",
    "desktop:start": "electron .",
    "test:e2e": "npm run desktop:build && playwright test",
    "format": "prettier --write src electron scripts tests *.json *.ts .github index.html",
    "format:check": "prettier --check src electron scripts tests *.json *.ts .github index.html"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "lucide-react": "^0.577.0",
    "mdast-util-to-string": "^4.0.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
